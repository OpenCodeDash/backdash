# Rendered by entrypoint.sh into /etc/nginx/conf.d/app.conf
# (envsubst substitutes only ${BACKDASH_PORT}; nginx variables are left alone).
server {
    listen 8080;
    server_name _;

    root /app/dash;
    index index.html;

    # ---- backdash REST + SSE, mounted at /api ------------------------------
    # The browser and the kanban plugin point at <origin>/api, e.g.
    #   KANBAN_URL=http://<host>:<port>/api
    # proxy_pass with a trailing slash strips the /api prefix before the
    # request reaches backdash (so /api/kanban -> /kanban).
    location = /api {
        return 308 /api/;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:${BACKDASH_PORT}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # SSE endpoints (/api/events, /api/boards/:id/events) must stream, so
        # never buffer or cache them.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # ---- opencode server, at the ROOT path /opencode -----------------------
    # dash is built with VITE_OPENCODE_URL=/opencode and reaches opencode on the
    # same origin (no CORS); nginx proxies it to OPENCODE_UPSTREAM at runtime,
    # so the opencode host is changeable with an env var (no rebuild). A ROOT
    # path, never /api/opencode.
    location = /opencode {
        return 308 /opencode/;
    }

    include /etc/nginx/conf.d/opencode.location;

    # ---- MCP server, at the ROOT path /mcp (never /api/mcp) ----------------
    # Proxied to MCP_UPSTREAM when set; otherwise /mcp fails loudly instead of
    # falling through to the SPA. See the Docker section of the backdash README.
    include /etc/nginx/conf.d/mcp.location;

    # ---- dash SPA ----------------------------------------------------------
    location / {
        try_files $uri $uri/ /index.html;
    }
}
